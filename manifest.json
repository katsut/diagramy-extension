{
  "manifest_version": 3,
  "name": "Figney",
  "version": "0.2.0",
  "description": "テキストを選択して図式化。右クリックで即座にダイアグラムを生成。",
  "permissions": ["contextMenus", "activeTab", "storage", "identity"],
  "host_permissions": ["http://localhost:8147/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
